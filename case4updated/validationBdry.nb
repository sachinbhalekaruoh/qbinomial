Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"f3", "=", 
  RowBox[{"ParametricPlot", "[", 
   RowBox[{
    RowBox[{"ReIm", "[", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"I", "*", "theta"}], "]"}], " ", 
       FractionBox[
        RowBox[{"QPochhammer", "[", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "I"}], "*", "theta"}], "]"}], ",", "q"}], "]"}], 
        RowBox[{"QPochhammer", "[", 
         RowBox[{
          RowBox[{
           SuperscriptBox["q", "\[Alpha]"], 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], "*", "theta"}], "]"}]}], ",", "q"}], 
         "]"}]]}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"theta", ",", 
      RowBox[{
       RowBox[{"4", "Pi"}], "-", "0.2"}], ",", 
      RowBox[{"4", "Pi"}]}], "}"}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", "Black"}], ",", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<Re(a)\>\"", ",", "\"\<Im(a)\>\""}], "}"}]}], ",", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "0.4"}], ",", "1.6"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1.2"}], ",", "1.2"}], "}"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9992382655536113`*^9, 3.999238277161812*^9}},
