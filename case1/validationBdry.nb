          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], "*", "theta"}], "]"}], ",", "q"}], "]"}], 
         RowBox[{"QPochhammer", "[", 
          RowBox[{
           RowBox[{
            SuperscriptBox["q", "\[Alpha]"], 
            RowBox[{"Exp", "[", 
