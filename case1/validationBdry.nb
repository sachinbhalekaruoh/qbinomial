Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"f1", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"ReIm", "[", 
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"I", "*", "theta"}], "]"}], " ", 
        FractionBox[
         RowBox[{"QPochhammer", "[", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], "*", "theta"}], "]"}], ",", "q"}], "]"}], 
         RowBox[{"QPochhammer", "[", 
          RowBox[{
           RowBox[{
            SuperscriptBox["q", "\[Alpha]"], 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], "*", "theta"}], "]"}]}], ",", "q"}], 
          "]"}]]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"theta", ",", "0", ",", 
       RowBox[{"2", "Pi"}]}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Black"}], ",", 
     RowBox[{"AxesLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<Re(a)\>\"", ",", "\"\<Im(a)\>\""}], "}"}]}], ",", 
